# 复制为 .env 后按需修改。所有变量前缀 APP_。
# 作者：晨星

# 基础
APP_APP_NAME=AI Platform Agent-RAG
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["*"]

# 鉴权（生产建议 true）
APP_AUTH_ENABLED=false
APP_JWT_SECRET=change-me-to-a-long-random-string
APP_JWT_ALG=HS256
APP_ACCESS_TOKEN_EXPIRE_MIN=60
APP_DEMO_USERNAME=demo
APP_DEMO_PASSWORD=demo1234

# 限流
APP_RATE_LIMIT_PER_MIN=60

# 模型供给：mock（离线）/ ollama（本地）/ openai（任意兼容服务）
APP_LLM_PROVIDER=mock
APP_LLM_BASE_URL=http://localhost:11434
APP_LLM_MODEL=qwen2.5:3b
APP_LLM_API_KEY=
APP_LLM_TEMPERATURE=0.2

# 向量化：hash（免下载）/ sentence-transformers（真实模型，需 pip install 可选依赖）
APP_EMBEDDING_PROVIDER=hash
APP_EMBEDDING_MODEL=all-MiniLM-L6-v2
APP_EMBEDDING_DIM=256

# 存储
APP_CHROMA_PATH=./data/chroma
APP_CHROMA_COLLECTION=docs
APP_DATABASE_URL=sqlite:///./data/app.db
